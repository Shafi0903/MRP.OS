# ==============================================================================
# MRP.OS Production Environment Variables
# Copy to .env: cp .env.example .env
# ==============================================================================

# Application Settings
APP_NAME=MRP Management System
APP_ENV=production
DEBUG=false
SECRET_KEY=change-this-to-a-very-strong-secret-in-production

# Web Server Port (Frontend exposes on this host port)
PORT=80

# PostgreSQL Settings (Used by docker-compose.yml)
POSTGRES_DB=mrp
POSTGRES_USER=mrp_user
POSTGRES_PASSWORD=mrp_secure_password_2026

# Seed initial Indian manufacturing demo data (true / false)
SEED_DEMO=true

# Regional & Currency Settings
DEFAULT_CURRENCY=INR
BUSINESS_TIMEZONE=Asia/Kolkata
